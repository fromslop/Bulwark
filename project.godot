; Engine configuration file.

config_version=5

[application]

config/name="Hoardsman"
config/version="0.6.12"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[physics]

2d/default_gravity=980.0
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=3

[editor_plugins]

enabled=PackedStringArray("res://addons/headnhands/plugin.cfg")

[headnhands]

paths/characters_dir="res://recording/characters"
paths/takes_dir="res://recording/takes"
paths/animations_dir="res://animations"
cues/provider="res://recording/hoardsman_cues.gd"

[xr]

openxr/enabled=false
openxr/default_action_map="res://recording/openxr_action_map.tres"
openxr/startup_alert=false
shaders/enabled=true
